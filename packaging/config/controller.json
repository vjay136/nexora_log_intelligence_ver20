{
  "listen_address": "127.0.0.1:12382",
  "state_dir": "/var/lib/nli-controller",
  "web_dir": "/usr/share/nli/webview_ver20",
  "tls_cert": "",
  "tls_key": "",
  "allow_insecure_remote": false,
  "force_secure_cookies": false,
  "enrollment_token_env": "NLI_ENROLLMENT_TOKEN",
  "bootstrap_admin_password_env": "NLI_BOOTSTRAP_ADMIN_PASSWORD",
  "bootstrap_admin_password_file": "/var/lib/nli-controller/bootstrap-admin-password",
  "audit_key_env": "NLI_AUDIT_HMAC_KEY",
  "csrf_key_env": "NLI_CSRF_HMAC_KEY",
  "assurance_key_env": "NLI_ASSURANCE_ENCRYPTION_KEY",
  "artifact_public_keys_env": "NLI_ARTIFACT_ED25519_PUBLIC_KEYS",
  "supabase_url_env": "SUPABASE_URL",
  "supabase_publishable_key_env": "SUPABASE_PUBLISHABLE_KEY",
  "supabase_controller_secret_env": "NLI_SUPABASE_CONTROLLER_SECRET",
  "supabase_secret_key_env": "SUPABASE_SECRET_KEY",
  "command_lease_seconds": 120,
  "event_path": "/var/lib/nli-controller/event-metadata.jsonl",
  "event_retention": 10000,
  "enable_legacy_event_ingest": false,
  "storage_provider": "supabase",
  "storage_dir": "/var/lib/nli-controller/metadata",
  "storage_allow_insecure": false,
  "assurance_retention_enabled": true,
  "assurance_retention_manual": true,
  "assurance_retention_max": 500,
  "assurance_retention_hours": 720,
  "artifact_public_keys": [],
  "max_artifact_bytes": 536870912,
  "rate_limit": 300,
  "rate_window_seconds": 60
}
